# ============================================================================
# Шаблон змінних оточення для Smart Expense Bot.
# Скопіюйте цей файл у `.env` та заповніть реальними значеннями.
# ============================================================================

# Токен Telegram-бота, отриманий від @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Рядок підключення до PostgreSQL (asyncpg драйвер)
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_expense

# Рівень логування (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Локалізація застосунку
LOCALE=uk

# Облікові дані PostgreSQL для docker-compose (мають збігатися з DB_URL).
# У production замініть POSTGRES_PASSWORD на сильне значення.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_expense

# API-ключ OpenRouter для Vision-LLM розпізнавання чеків
OPENROUTER_API_KEY=

# Ідентифікатор Vision-LLM моделі OpenRouter
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Базовий URL OpenAI-сумісного API OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
